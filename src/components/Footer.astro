---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getHref = (href: string) => (href === '/' ? `${base}/` : `${base}${href}`);
---

<footer class="bg-gray-950 text-gray-300 border-t border-brand-burgundy-900/40">
  <!-- Top decorative bar with brand colors -->
  <div class="h-1.5 bg-gradient-to-r from-brand-burgundy-800 via-brand-gold-500 to-brand-navy-700"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Col 1: Brand & Identity -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-brand-burgundy-800 flex items-center justify-center text-white shadow">
            <svg class="w-6 h-6 text-brand-gold-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 21h18"/>
              <path d="M5 21V10l7-5 7 5v11"/>
              <path d="M9 21v-6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v6"/>
            </svg>
          </div>
          <div>
            <h3 class="text-base font-serif font-bold text-white leading-tight">Red Nacional de Museos Universitarios</h3>
            <span class="text-xs text-brand-gold-400 font-medium">RNMU • Colombia</span>
          </div>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">
          Espacio de encuentro, cooperación y fortalecimiento mutuo que reúne a museos, colecciones y espacios patrimoniales de las Instituciones de Educación Superior de Colombia.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-900 border border-gray-800 text-xs text-gray-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Red temática avalada por el <strong>PFM</strong></span>
        </div>
      </div>

      <!-- Col 2: Enlaces Rápidos -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-brand-gold-300 mb-4">Navegación</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={getHref('/')} class="hover:text-white transition-colors flex items-center gap-1.5">
              <span>›</span> Inicio
            </a>
          </li>
          <li>
            <a href={getHref('/quienes-somos')} class="hover:text-white transition-colors flex items-center gap-1.5">
              <span>›</span> Quiénes Somos
            </a>
          </li>
          <li>
            <a href={getHref('/directorio')} class="hover:text-white transition-colors flex items-center gap-1.5">
              <span>›</span> Directorio de Museos
            </a>
          </li>
          <li>
            <a href={getHref('/caracterizacion')} class="hover:text-white transition-colors flex items-center gap-1.5">
              <span>›</span> Caracterización de Museos
            </a>
          </li>
          <li>
            <a href={getHref('/faq')} class="hover:text-white transition-colors flex items-center gap-1.5">
              <span>›</span> Preguntas Frecuentes
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Marco Legal y Coordinación -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-brand-gold-300 mb-4">Marco y Coordinación</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-brand-gold-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Resolución 1975 de 2013</strong> — MinCultura (Estructura organizativa y redes temáticas).</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-brand-gold-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span><strong>Coordinación 2026:</strong> Museo de Trajes de la Universidad de América.</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-brand-gold-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span><strong>Factor 7 CNA:</strong> Características 23 y 24 para acreditación institucional.</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contacto Oficial -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-brand-gold-300 mb-4">Canales Oficiales</h4>
        <div class="space-y-3.5 text-sm">
          <div>
            <span class="block text-xs text-gray-500 uppercase tracking-wide">Correo de la Red</span>
            <a href="mailto:reddemuseosuniversitarios@gmail.com" class="text-brand-gold-300 hover:text-white font-medium break-all">
              reddemuseosuniversitarios@gmail.com
            </a>
          </div>
          <div>
            <span class="block text-xs text-gray-500 uppercase tracking-wide">Línea de Caracterización / WhatsApp</span>
            <a href="https://wa.me/573164963906" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-medium inline-flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              +57 316 496 3906
            </a>
          </div>
          <div>
            <span class="block text-xs text-gray-500 uppercase tracking-wide">Participación</span>
            <span class="text-xs text-emerald-300 font-medium">100% Gratuita • Sin compromisos jurídicos</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Habeas Data -->
    <div class="mt-12 pt-8 border-t border-gray-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>
        © 2026 Red Nacional de Museos Universitarios de Colombia (RNMU). Alojado en GitHub Pages con costo $0 de infraestructura.
      </p>
      <div class="flex items-center gap-4">
        <span>Ley 1581 de 2012 (Habeas Data)</span>
        <span>•</span>
        <a href="https://github.com/Stephanos333/Red-Nacional-de-Museos-Universitarios" target="_blank" rel="noopener noreferrer" class="hover:text-gray-300 transition-colors">
          Código Abierto
        </a>
      </div>
    </div>
  </div>
</footer>
